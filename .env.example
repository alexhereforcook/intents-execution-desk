# 1Click API key (Partners Portal -> API Keys -> Distribution Channel)
ONECLICK_API_KEY=

# Database. Local default is SQLite; on Render use a Postgres URL (Neon / Supabase).
DATABASE_URL=sqlite:///desk.db

# Agent signing key: hex-encoded 32-byte ed25519 seed.
# The agent's NEAR Intents account is the implicit account derived from it.
# Only needed for LIVE mode. Leave empty for SHADOW mode (default).
AGENT_SEED_HEX=

# Mode: shadow (dry quotes only, no signing) or live (signs and submits intents)
DESK_MODE=shadow

# Sputnik DAOs whose approved "execution-desk:" proposals become orders (comma-separated)
DESK_DAOS=
DESK_DAO_NETWORK=testnet
